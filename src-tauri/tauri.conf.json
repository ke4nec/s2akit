{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "s2akit",
  "version": "0.2.1",
  "identifier": "com.niq.s2akit",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "s2akit",
        "visible": false,
        "decorations": false,
        "width": 1000,
        "height": 640,
        "minWidth": 1000,
        "minHeight": 640
      },
      {
        "label": "tray-menu",
        "url": "index.html#tray-menu",
        "title": "",
        "visible": false,
        "width": 240,
        "height": 540,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "shadow": false,
        "windowEffects": {
          "effects": ["acrylic"],
          "color": "#F2F2F5"
        }
      },
      {
        "label": "tray-submenu",
        "url": "index.html#tray-submenu",
        "title": "",
        "visible": false,
        "width": 188,
        "height": 120,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "focusable": false,
        "focus": false,
        "shadow": false,
        "windowEffects": {
          "effects": ["acrylic"],
          "color": "#F2F2F5"
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJDNjlBOEE3NEM3QkE5RjYKUldUMnFYdE1wNmhwTE9IV3l5Z2VRTlBRSWlPOVVXNTlJczJZaGZUaytDalArUUMyb1NMbWJuRVUK",
      "endpoints": [
        "https://github.com/ke4nec/s2akit/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
